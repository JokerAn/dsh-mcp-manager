{
  "name": "@local/dsh-mcp-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 桌面端 MCP 管理插件：卡片式服务器管理、自定义 stdio/Streamable HTTP 接入、公共 MCP 目录一键安装。",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-shell",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT"
}
